# Copy to .env (or export in your shell) — the server reads these.

# The platform GradeScriptUG API key. Format: gsk_<8 hex>_<32 hex>
# Normally the administrator sets this in the UI (Platform → Verify & save),
# which stores it server-side. Setting it here overrides the stored key and is
# the recommended way in production. Leave empty to run in demo mode.
GRADESCRIPT_API_KEY=

# The one account allowed to hold the platform key. Signing up or using Google
# with this address is the only way to become an administrator.
ADMIN_EMAIL=ryanroject@gmail.com

# Password for the seeded admin account (change it after first sign-in).
ADMIN_PASSWORD=volyx-admin-2026

# Port to listen on
PORT=3000

# Where the SQLite database lives. Default: data/volyx.db
# VOLYX_DB=/var/lib/volyx/volyx.db

# Set to "production" behind HTTPS so the session cookie is Secure
NODE_ENV=development

# Google OAuth Client ID for "Continue with Google" (Gmail sign-in).
# Create it in Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Add http://localhost:3000 and your production URL as authorised JavaScript origins.
GOOGLE_CLIENT_ID=

# ── Email delivery for verification codes ────────────────────────────────────
# Gmail is the quickest real setup: turn on 2-Step Verification, create an
# App password (https://myaccount.google.com/apppasswords), then set these two.
# Spaces in the app password are ignored.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Any other SMTP relay (Brevo, Mailgun, Zoho, your school's mail server, …).
# Use instead of GMAIL_*, or alongside SMTP_HOST to point Gmail credentials
# at a relay. SMTP_URL=smtps://user:pass@host:465 also works.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# What recipients see in the From: line. Gmail insists the sender is the
# signed-in account, so leave blank when using GMAIL_USER.
MAIL_FROM=

# HTTPS API instead of SMTP — no outbound ports needed. Best for production.
RESEND_API_KEY=

# Local debugging only: show the code on screen even when mail is configured.
# Never enable this on a real deployment.
MAIL_SCREEN_FALLBACK=
MAIL_FROM="Volyx <codes@your-domain.com>"

# Legacy/optional SMTP (not bundled — plug your own transport in lib/mailer.js)
SMTP_URL=
